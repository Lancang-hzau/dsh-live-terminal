{
  "name": "dsh-live-terminal",
  "version": "1.3.0",
  "description": "Visible terminal panel for DeepSeek Harness: stream agent shell commands into an in-app terminal live and let the agent take text screenshots of the terminal screen. DSH 可见终端面板：agent 命令实时显示 + 终端屏幕截图。",
  "type": "module",
  "license": "MIT",
  "author": "LANCANG",
  "homepage": "https://github.com/Lancang-hzau/dsh-live-terminal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lancang-hzau/dsh-live-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/Lancang-hzau/dsh-live-terminal/issues"
  },
  "icon": "icon.svg",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "deepseek",
    "cordis",
    "terminal",
    "pty",
    "xterm",
    "agent-tools",
    "screenshot",
    "sidebar"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "scripts": {
    "build": "node tools/build-client.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:ui": "node tools/verify-ui.mjs",
    "prepack": "node tools/build-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2 <0.3.0-0"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
