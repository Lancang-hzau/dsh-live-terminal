{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/dsh-client-ui-primitives": ["./types/dsh-client-ui-primitives.d.ts"]
    }
  },
  "include": ["tools/**/*.mjs", "client-src/**/*.ts", "client-src/**/*.tsx", "tests/**/*.mjs", "types/**/*.d.ts"]
}
